@startuml API Raízes do Nordeste
left to right direction

skinparam dpi 180
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 65
skinparam ArrowColor #334155
skinparam ActorBorderColor #1E3A5F
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1E3A5F
skinparam UsecaseBackgroundColor #F8FAFC
skinparam RectangleBorderColor #1E3A5F
skinparam RectangleBackgroundColor #FFFFFF

actor "Cliente\n(App / Web / Totem)" as Cliente
actor "Atendente\n(Balcão)" as Atendente

rectangle "API Raízes do Nordeste" {
  usecase "UC01 - Cadastrar\nCliente" as UC01
  usecase "UC13 - Fidelidade e\nConsentimento LGPD" as UC13
  usecase "UC03 - Consultar Unidades\ne Cardápio" as UC03
  usecase "UC04 - Realizar Pedido\n(Multicanal)" as UC04
  usecase "UC05 - Validar e\nReservar Estoque" as UC05
  usecase "UC06 - Aplicar Promoção /\nResgatar Fidelidade" as UC06
  usecase "UC07 - Solicitar\nPagamento (Mock)" as UC07

  usecase "UC02 - Autenticar\nUsuário (JWT)" as UC02
  usecase "UC08 - Consultar Pedidos\ne Filtros por Canal" as UC08
  usecase "UC09 - Atualizar Status /\nCancelar Pedido" as UC09

  usecase "UC10 - Consultar Fila\nde Preparo" as UC10
  usecase "UC11 - Gerenciar Unidades,\nCardápio e Promoções" as UC11
  usecase "UC12 - Movimentar e\nConsultar Estoque" as UC12
  usecase "UC14 - Consultar Logs\nde Auditoria" as UC14
}

actor "Gateway de Pagamento\n(Mock)" as Gateway
actor "Cozinha" as Cozinha
actor "Gerente" as Gerente
actor "Administrador" as Admin

Cliente -- UC01
Cliente -- UC13
Cliente -- UC03
Cliente -- UC04
Cliente -- UC07
Cliente -- UC02
Cliente -- UC08
Cliente -- UC09

Atendente -- UC03
Atendente -- UC04
Atendente -- UC07
Atendente -- UC02
Atendente -- UC08
Atendente -- UC09

UC04 ..> UC05 : <<include>>
UC04 <.. UC06 : <<extend>>

UC07 -- Gateway

UC02 -- Cozinha
UC09 -- Cozinha
UC10 -- Cozinha

UC02 -- Gerente
UC04 -- Gerente
UC07 -- Gerente
UC08 -- Gerente
UC09 -- Gerente
UC12 -- Gerente
UC14 -- Gerente

UC02 -- Admin
UC04 -- Admin
UC07 -- Admin
UC08 -- Admin
UC09 -- Admin
UC11 -- Admin
UC12 -- Admin
UC14 -- Admin
@enduml
