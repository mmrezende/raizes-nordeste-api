classDiagram
  direction TB

  namespace Identidade_e_Auditoria {
    class PerfilUsuario {
      <<enumeration>>
      CLIENTE
      ATENDENTE
      COZINHA
      GERENTE
      ADMIN
    }

    class Usuario {
      +string id
      +string? unidadeId
      +string nome
      +string email
      +string senhaHash
      +PerfilUsuario perfil
      +boolean ativo
      +Date? anonimizadoEm
      +criarUsuarioInterno(input, ator) UsuarioSeguro
      +validarEscopoUnidade(ator, unidadeId) void
      +anonimizar(usuarioId) UsuarioAnonimizadoResultado
    }

    class LogAuditoria {
      +string id
      +string? usuarioId
      +string acao
      +string entidade
      +string entidadeId
      +string? metadados
      +string? requestId
      +Date createdAt
      +registrar(input) Promise~void~
    }
  }

  namespace Rede_e_Estoque {
    class Unidade {
      +string id
      +string codigo
      +string nome
      +string endereco
      +boolean ativo
      +Date createdAt
      +Date updatedAt
      +criar(input) Unidade
      +listar(paginacao) ResultadoPaginado
      +consultarCardapio(unidadeId, paginacao) ResultadoPaginado
    }

    class Produto {
      +string id
      +string nome
      +string? descricao
      +string categoria
      +number precoCentavos
      +boolean ativo
      +criar(input) ProdutoResultado
      +listar(paginacao) ResultadoPaginado
    }

    class EstoqueUnidade {
      +string id
      +string unidadeId
      +string produtoId
      +number quantidadeDisponivel
      +boolean disponivelVenda
      +Date updatedAt
      +consultarPorUnidade(unidadeId, paginacao, ator) ResultadoPaginado
      +mapearEstoqueItem(registro) EstoqueItemFormatado
    }

    class MovimentacaoEstoque {
      +string id
      +string estoqueUnidadeId
      +string usuarioId
      +string? pedidoId
      +TipoMovimentacaoEstoque tipo
      +number quantidade
      +string? motivo
      +Date createdAt
      +registrarMovimentacao(input, ator) MovimentacaoResultado
    }
  }

  namespace Pedidos_e_Promocoes {
    class CanalPedido {
      <<enumeration>>
      APP
      TOTEM
      BALCAO
      PICKUP
      WEB
    }

    class StatusPedido {
      <<enumeration>>
      AGUARDANDO_PAGAMENTO
      EM_PREPARO
      PRONTO
      ENTREGUE
      PAGAMENTO_RECUSADO
      CANCELADO
    }

    class Promocao {
      +string id
      +string? unidadeId
      +string codigo
      +string descricao
      +TipoDesconto tipoDesconto
      +number valorDesconto
      +number valorMinimoCentavos
      +CanalPedido? canalAplicavel
      +Date inicioEm
      +Date fimEm
      +boolean ativo
      +criar(input) PromocaoResultado
      +validarECalcularDescontoPromocao(promocao, contexto) number
    }

    class Pedido {
      +string id
      +string unidadeId
      +string clienteId
      +string? promocaoId
      +CanalPedido canalPedido
      +StatusPedido status
      +number subtotalCentavos
      +number descontoPromocaoCentavos
      +number pontosUtilizados
      +number descontoFidelidadeCentavos
      +number valorTotalCentavos
      +criar(input, ator) PedidoResultado
      +validarTransicaoStatusPedido(input) void
      +validarCancelamentoPedido(input) void
      +estornarReservasDoPedido(tx, idGenerator, input) Promise~void~
    }

    class ItemPedido {
      +string id
      +string pedidoId
      +string produtoId
      +number quantidade
      +number precoUnitarioCentavos
      +number subtotalCentavos
      +centavosParaReais(centavos) number
    }
  }

  namespace Pagamentos {
    class StatusPagamento {
      <<enumeration>>
      PENDENTE
      APROVADO
      RECUSADO
    }

    class Pagamento {
      +string id
      +string pedidoId
      +string idempotencyKey
      +FormaPagamento formaPagamento
      +StatusPagamento status
      +number valorCentavos
      +string? referenciaExterna
      +string? payloadRetorno
      +Date? processadoEm
      +processar(input, ator) ProcessarPagamentoOutput
    }
  }

  namespace Fidelidade_LGPD {
    class ContaFidelidade {
      +string id
      +string usuarioId
      +number saldoPontos
      +boolean consentimentoAtivo
      +Date? consentimentoEm
      +Date? revogadoEm
      +Date updatedAt
      +consultarConta(usuarioId) ContaFidelidade
      +atualizarConsentimento(usuarioId, ativo) ContaFidelidade
      +calcularDescontoFidelidade(params) CalculoFidelidadeResultado
      +calcularPontosAcumulo(valorTotalCentavos) number
    }

    class MovimentacaoFidelidade {
      +string id
      +string contaFidelidadeId
      +string? pedidoId
      +TipoMovimentacaoFidelidade tipo
      +number pontos
      +string? descricao
      +Date createdAt
      +listarMovimentacoes(usuarioId, paginacao) ResultadoPaginado
    }
  }

  Unidade "0..1" --> "0..*" Usuario : vincula equipe
  Unidade "1" --> "0..*" EstoqueUnidade : mantém
  Produto "1" --> "0..*" EstoqueUnidade : disponível em
  EstoqueUnidade "1" --> "0..*" MovimentacaoEstoque : registra
  Usuario "1" --> "0..*" MovimentacaoEstoque : executa

  Unidade "1" --> "0..*" Pedido : recebe
  Usuario "1" --> "0..*" Pedido : realiza
  Unidade "0..1" --> "0..*" Promocao : restringe
  Promocao "0..1" --> "0..*" Pedido : aplica
  Pedido "1" *-- "1..*" ItemPedido : contém
  Produto "1" --> "0..*" ItemPedido : referencia

  Pedido "1" --> "0..*" Pagamento : processa
  Usuario "1" -- "0..1" ContaFidelidade : possui
  ContaFidelidade "1" --> "0..*" MovimentacaoFidelidade : movimenta
  Pedido "0..1" --> "0..*" MovimentacaoFidelidade : gera pontos
  LogAuditoria "0..*" --> "0..1" Usuario : referencia autor
